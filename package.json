{
  "name": "relay",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "format:check": "prettier --check src tests scripts .github *.json *.ts .prettierrc.json",
    "format": "prettier --write src tests scripts .github *.json *.ts .prettierrc.json",
    "check:files": "node scripts/check-files.mjs",
    "test:integration": "node scripts/require-firebase.mjs && playwright test --config playwright.integration.config.ts"
  },
  "dependencies": {
    "firebase": "12.19.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.56.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "25.0.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "6.4.6",
    "vitest": "4.1.12"
  },
  "overrides": {
    "playwright-core": "1.56.1",
    "@grpc/grpc-js": "1.14.7"
  }
}

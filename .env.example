# Firebase Web app configuration. These values identify the public web app;
# never put service-account credentials or private server keys in VITE_* variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Public reCAPTCHA Enterprise site key for Firebase App Check on the deployed domain.
# Cloud-capable hybrid requests stay disabled until this is configured.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
